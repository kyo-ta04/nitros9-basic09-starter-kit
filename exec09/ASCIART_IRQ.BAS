490 REM
500 REM ****************************************
510 REM timer_irq_load_rts.bas  MS-BASIC (SBC6809)
520 REM Load timer_irq_rts ML to $5000 (RETURNS to BASIC)
530 REM
540 REM  EXEC &H5000  enables TIMER + IRQ, then RTS
550 REM  Counter at $6000 increments in background
560 REM  Does NOT LDS / does NOT hang in ML loop
570 REM
580 REM  $5000 Start (setup + RTS)
590 REM  $5010 IRQ  (INC $8010; $6000++)
600 REM ****************************************
610 REM
620 A=&H5000
630 FOR I=0 TO 30
640 READ D
650 POKE A+I,D
660 NEXT I
670 PRINT "ML loaded $5000-$501E (31 bytes, RTS version)"
680 REM
690 REM IRQ vector -> $5010
700 POKE &HFFF8,&H50
710 POKE &HFFF9,&H10
720 PRINT "IRQ vector $FFF8 -> $5010"
730 POKE &H6000,0:POKE &H6001,0
740 PRINT "Counter $6000 cleared"
750 PRINT
760 PRINT "Start timer:  EXEC &H5000   (returns to BASIC)"
770 PRINT "Read count:   RUN 1000"
780 PRINT "Stop timer:   RUN 1100"
790 END
800 REM
810 REM ===== ML $5000-$501E (timer_irq_rts.asm) =====
820 DATA &H1A,&H50
830 DATA &H7F,&H60,&H00
840 DATA &H7F,&H60,&H01
850 DATA &H86,&H02
860 DATA &HB7,&H80,&H10
870 DATA &H1C,&HEF
880 DATA &H39
890 DATA &H7C,&H80,&H10
900 DATA &H2A,&H09
910 DATA &HFC,&H60,&H00
920 DATA &HC3,&H00,&H01
930 DATA &HFD,&H60,&H00
940 DATA &H3B
950 REM
960 C=PEEK(&H6000)*256+PEEK(&H6001)
970 PRINT "Counter $6000 =";C
980 RETURN
1000 REM ===== Print counter =====
1010 REM RUN 1000
1020 C=PEEK(&H6000)*256+PEEK(&H6001)
1030 PRINT "Counter $6000 =";C
1040 END
1050 REM
1100 REM ===== Stop timer (disable + mask IRQ) =====
1110 REM RUN 1100
1120 POKE &H8010,0
1130 REM Soft mask IRQ via CC is not available in BASIC;
1140 REM disabling TIMER stops further IRQs.
1150 PRINT "TIMER disabled ($8010=0)"
1160 END
1170 REM
1200 REM ===== Start (EXEC; returns) =====
1210 REM RUN 1200
1220 PRINT "EXEC $5000 ..."
1230 EXEC &H5000
1240 PRINT "Back in BASIC. Counter=";PEEK(&H6000)*256+PEEK(&H6001)
1250 END
